{
  "manifest_version": 3,
  "name": "WhatsApp Group & Contact links Finder",
  "version": "1.0.1",
  "description": "WhatsApp Group & Contact links Finder tool.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WA Scraper",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.google.com/*",
    "*://*.facebook.com/*",
    "*://web.whatsapp.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.google.com/search*",
        "*://*.facebook.com/search*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
